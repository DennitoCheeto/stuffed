[gd_resource type="Resource" script_class="FloorPickupRules" load_steps=6 format=3]

[ext_resource type="Script" path="res://src/pickups/floor_pickup_rules.gd" id="1_rules"]
[ext_resource type="Script" path="res://src/pickups/floor_pickup_def.gd" id="2_def"]

[sub_resource type="Resource" id="Resource_magnet"]
script = ExtResource("2_def")
id = &"magnet"
display_name = "Big Magnet"
scrapbook_text = "Every XP button on the floor flies to you at once."
banner = "BIG MAGNET!"
banner_subtitle = "All XP flies to you"
weight = 40.0
sound = &"magnet"

[sub_resource type="Resource" id="Resource_snow_globe"]
script = ExtResource("2_def")
id = &"snow_globe"
display_name = "Snow Globe"
scrapbook_text = "Freezes the whole horde for a few seconds. Bosses only slow down."
banner = "SNOW GLOBE!"
banner_subtitle = "The horde is frozen"
weight = 30.0
sound = &"snow_globe"

[sub_resource type="Resource" id="Resource_party_popper"]
script = ExtResource("2_def")
id = &"party_popper"
display_name = "Party Popper"
scrapbook_text = "Confetti hits every zombie on screen. Normal ones pop right away."
banner = "PARTY POPPER!"
banner_subtitle = "Confetti for everyone"
weight = 30.0
sound = &"party_popper"

[resource]
script = ExtResource("1_rules")
kinds = Array[ExtResource("2_def")]([SubResource("Resource_magnet"), SubResource("Resource_snow_globe"), SubResource("Resource_party_popper")])
first_drop_after = 30.0
min_gap = 45.0
gap_spread = 30.0
drop_chance = 0.25
max_on_floor = 2
touch_radius = 22.0
banner_seconds = 1.8
freeze_seconds = 5.0
freeze_crack_seconds = 1.0
freeze_boss_speed = 0.5
popper_elite_share = 0.4
popper_boss_share = 0.05
popper_seconds = 1.4
