[resource]
script = ExtResource("1_rules")
tracks = Array[ExtResource("2_track")]([ExtResource("3_title"), ExtResource("4_town"), ExtResource("5_run"), ExtResource("6_boss"), ExtResource("7_siege"), ExtResource("8_endless")])
stingers = Array[ExtResource("2_track")]([ExtResource("9_goal"), ExtResource("10_hero_died"), ExtResource("11_siege_won"), ExtResource("12_siege_lost"), ExtResource("13_evolution")])
crossfade_seconds = 1.0
layer_fade_seconds = 2.0
loudness = 0.5
stinger_loudness = 0.6
stinger_duck = 0.35
duck_seconds = 0.15
